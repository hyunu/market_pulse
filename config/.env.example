# MarketPulse 환경 변수 예시 — 실제 키는 커밋하지 마세요.
# 사용법: cp config/.env.example .env 후 값을 채웁니다.

DATABASE_URL=postgresql://marketpulse:marketpulse@localhost:5432/marketpulse

# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# https://www.bls.gov/developers/api_signature_v2.htm
BLS_API_KEY=

# https://apps.bea.gov/API/signup/
BEA_API_KEY=

INDICATORS_YAML=config/indicators.yaml
API_HOST=0.0.0.0
API_PORT=8000

# 테스트/오프라인 전용. 기본 false — 실서비스에서 가짜 시계열 금지
ALLOW_SYNTHETIC_FALLBACK=0

# Yahoo 프로토타입 실호출 (1=기본). LICENSE: prototype only.
MARKET_COLLECTOR_LIVE=1

# AI 설정 암호화(Fernet). 비우면 .data/settings.fernet.key 자동 생성(셀프호스트).
# 실제 AI API 키는 앱 Settings 화면에서 등록 — 여기/코드에 넣지 마세요.
SETTINGS_FERNET_KEY=

# 수집 잡 연타 쿨다운(초)
COLLECT_COOLDOWN_SEC=45
